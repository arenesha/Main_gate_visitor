{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "main-gate-visitor-authorization",
  "main": "src/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "visitor-invitation-db",
      "database_id": "local-d1-placeholder",
      "migrations_dir": "migrations"
    }
  ]
}
