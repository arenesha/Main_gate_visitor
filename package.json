{
  "name": "main-gate-visitor-authorization-system",
  "version": "2.0.0",
  "description": "Cloudflare Worker + D1 + React Main Gate Visitor Authorization & Security Checkpoint System",
  "type": "module",
  "scripts": {
    "start": "concurrently -n \"BACKEND,NOTIFY,FRONTEND\" -c \"blue,magenta,green\" \"npm run dev:backend\" \"npm run dev:notify\" \"npm run dev:frontend\"",
    "dev": "npm start",
    "dev:backend": "wrangler dev --port 8788",
    "dev:notify": "node src/notifyServer.js",
    "dev:frontend": "npm run --prefix frontend dev",
    "build:frontend": "npm run --prefix frontend build",
    "preview": "npm run --prefix frontend preview",
    "deploy": "npm run build:frontend && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply visitor-invitation-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply visitor-invitation-db --remote",
    "test": "node test-e2e.js"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "wrangler": "^3.107.0 || ^4.0.0"
  },
  "dependencies": {
    "nodemailer": "^10.0.10",
    "qrcode": "^1.5.4"
  }
}
