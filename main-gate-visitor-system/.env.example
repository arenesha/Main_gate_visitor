# ==============================================================================
# MAIN GATE VISITOR AUTHORIZATION SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Port
PORT=5000
NODE_ENV=production
JWT_SECRET=your-secure-jwt-secret-key-change-this

# Initial Admin Authorization PIN (Will be hashed with bcrypt into SQLite)
DEFAULT_PIN=1234
AUTHORIZATION_EXPIRY_MINUTES=300

# ------------------------------------------------------------------------------
# REAL EMAIL CONFIGURATION (Gmail SMTP or Transactional SMTP)
# ------------------------------------------------------------------------------
# For Gmail: host=smtp.gmail.com, port=587, secure=false
# Use 16-letter App Password generated at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=authorized-email@gmail.com
SMTP_PASSWORD=GOOGLE_APP_PASSWORD
MAIN_GATE_EMAIL=main-gate@example.com

# ------------------------------------------------------------------------------
# REAL SMS CONFIGURATION (Twilio or Fast2SMS)
# ------------------------------------------------------------------------------
# Option A: Twilio (International & US/UK)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
SECURITY_PHONE_NUMBER=+91xxxxxxxxxx

# Option B: Fast2SMS (Direct for Indian Mobile Numbers)
FAST2SMS_API_KEY=your_fast2sms_api_key
