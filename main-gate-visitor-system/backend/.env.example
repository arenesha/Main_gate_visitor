# ========================================================
# Gatekeeper - Main Gate Visitor Entry Authorization System
# Environment Configuration Template
# ========================================================

# Server Port (Default 8003)
PORT=8003
NODE_ENV=development
REAL_NOTIFICATIONS=true

# Initial Admin Security PIN (bcrypt hashed or plain fallback for initial setup)
DEFAULT_PIN=1234
AUTHORIZATION_PIN_HASH=
AUTHORIZATION_EXPIRY_MINUTES=300

# Email Notifications (Gmail SMTP)
# IMPORTANT: SMTP_PASSWORD must be a 16-character Google App Password (not your Gmail password)
# To create: Google Account -> Security -> 2-Step Verification -> App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
SECURITY_EMAIL=security@example.com

# SMS Notifications (Twilio)
# Sign up at https://www.twilio.com/ to get Account SID, Auth Token & Twilio Phone Number
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
SECURITY_PHONE_NUMBER=+91XXXXXXXXXX

# Optional Indian SMS Provider (Fast2SMS)
# FAST2SMS_API_KEY=your_fast2sms_api_key_here
